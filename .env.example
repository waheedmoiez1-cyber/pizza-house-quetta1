# Pizza House Quetta - Portable Environment Configuration Example
# Rename this file to .env.local for local development or set in hosting platform settings.

PORT=3000
NODE_ENV=production

# Public site domain for SEO and Canonical URLs
NEXT_PUBLIC_SITE_URL=https://pizzahousequetta.com

# Admin Secret Credentials (Default fallback stored in data/db.json)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Dtan@1234


