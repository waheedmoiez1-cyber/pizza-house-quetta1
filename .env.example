# Pizza House Quetta - Environment Configuration
# Copy this to .env.local for local testing, or add these variables in your Vercel Project Settings (Settings -> Environment Variables).

PORT=3000
NODE_ENV=production

# Public site domain for SEO, WhatsApp redirects, and Canonical URLs
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Admin Secret Credentials (Used to log into /admin/login)
# Set your own secure admin credentials on Vercel:
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Dtan@1234

# --- Optional Free Cloud Database (Upstash Redis / Vercel KV) ---
# For permanent cross-device persistence across serverless cold starts,
# connect Upstash Redis in Vercel Marketplace (Free tier) or from https://console.upstash.com
# Vercel automatically populates these when you create a KV/Redis database:
# KV_REST_API_URL=https://your-upstash-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token

# --- Optional Free Image Upload Hosting (ImgBB) ---
# Get a free API key at https://api.imgbb.com (Optional for custom hosted uploads)
# IMGBB_API_KEY=your_imgbb_api_key



