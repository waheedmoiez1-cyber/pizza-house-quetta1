# Pizza House Quetta - Environment Configuration
# Copy this to .env.local for local testing, or add these variables in your Vercel / Server Settings.

PORT=3000
NODE_ENV=development

# Public site domain for SEO, WhatsApp redirects, and Canonical URLs
NEXT_PUBLIC_SITE_URL=https://pizzahousequetta.com

# Admin Secret Credentials (Used to log into /admin/login)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Dtan@1234

# --- MySQL Database Configuration (XAMPP / Localhost / Cloud MySQL) ---
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=pizza_house_quetta
# Optional: connection URI for Cloud MySQL (e.g., PlanetScale / Railway / AWS RDS)
# MYSQL_URL=mysql://root:password@localhost:3306/pizza_house_quetta

# --- Optional Free Cloud Database (Upstash Redis / Vercel KV) ---
# For permanent cross-device persistence across serverless cold starts
# KV_REST_API_URL=https://your-upstash-instance.upstash.io
# KV_REST_API_TOKEN=your_upstash_rest_token
